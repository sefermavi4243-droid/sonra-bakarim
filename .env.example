# Kanallar: en az biri dolu olmalı. Telegram en kolayı (ücretsiz, işletme hesabı gerekmez).

# Telegram: Telegram'da @BotFather → /newbot → verdiği token
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (isteğe bağlı; doldurulacaksa hepsi dolu olmalı)
# developers.facebook.com → uygulaman → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Uygulama ayarları → Temel → App Secret (webhook imzasını doğrulamak için)
WHATSAPP_APP_SECRET=
# Webhook doğrulaması için kendi belirlediğin rastgele bir dize; Meta paneline de aynısını yaz
WHATSAPP_VERIFY_TOKEN=
# Meta'nın güncel Graph API sürümü (ör. v2x.0); Meta panelinde görünür
WHATSAPP_GRAPH_VERSION=

# Veritabanı: boşsa gömülü Postgres (PGlite) ./data/pg klasöründe açılır; hesap gerekmez.
# Supabase için: postgres://… bağlantı adresi
DATABASE_URL=
# Medya deposu: Supabase doluysa özel bucket, boşsa MEDIA_DIR klasörü
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
MEDIA_DIR=./data/media

# Yerel dil modeli: OpenAI uyumlu /chat/completions ucu (ücretsiz, makinende çalışır).
# Ollama: http://localhost:11434/v1  ·  LM Studio: http://localhost:1234/v1  ·  llama-server: http://localhost:8080/v1
# Ekran görüntüsü okuyabilmesi için görsel destekli bir model seç (ör. ollama pull gemma3:12b).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3:12b
# Daha hızlı ama daha az isabetli: gemma3:4b (ollama pull gemma3:4b)
# Yerel sunucular anahtar istemez; boş bırak.
LLM_API_KEY=

# Sesi yazıya dökme (isteğe bağlı): OpenAI uyumlu /audio/transcriptions ucu.
# Boş bırakılırsa sesli notlara "yazarak atar mısın?" yanıtı verilir.
# Yerel seçenek (ücretsiz): scripts\setup-whisper.ps1 ile kur → http://127.0.0.1:8000/v1
# Model tools/whisper/server.py içinde WHISPER_MODEL ile seçilir (varsayılan small).
TRANSCRIBE_BASE_URL=http://127.0.0.1:8000/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=small

# Uygulama
APP_TIMEZONE=Europe/Istanbul
QUIET_HOURS=22:00-08:00
PORT=3000
# Yalnızca 127.0.0.1'i dinleyen yönetim ucu (npm run rapor bunu kullanır)
ADMIN_PORT=3001
