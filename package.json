{
  "name": "sonra-bakarim",
  "version": "1.0.0",
  "description": "WhatsApp üzerinden sonra bakılacak şeyleri yakalayan ve hatırlatan servis",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "tsc --noEmit",
    "rapor": "tsx src/report.ts",
    "bagla": "tsx src/bagla.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.11",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jsdom": "^29.1.1",
    "luxon": "^3.7.2",
    "postgres": "^3.4.9",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
